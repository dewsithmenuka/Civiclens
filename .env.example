NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3001

# Local Compose publishes PostgreSQL on host port 5433.
DATABASE_URL=postgres://civiclens:civiclens@localhost:5433/civiclens
# Use redis://localhost:6379 for a backend process running on the host.
REDIS_URL=redis://redis:6379

# Generate a unique production value with: openssl rand -base64 48
JWT_SECRET=change-me-dev-only-change-me-dev-only
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Set to the exact trusted proxy hop count only when the API is behind that proxy.
TRUST_PROXY=

DUPLICATE_RADIUS_M=50
DUPLICATE_WINDOW_HOURS=24

# Optional object storage — Cloudflare R2 / S3 / MinIO. All fields are required for uploads.
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=

# Email — leave SMTP_URL empty in development to log verification links.
APP_BASE_URL=http://localhost:3000
SMTP_URL=
MAIL_FROM=CivicLens <no-reply@civiclens.local>
REQUIRE_VERIFIED_EMAIL=false

# Optional identity and push providers.
GOOGLE_CLIENT_IDS=
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Admin dashboard process settings.
API_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3001
COOKIE_SECURE=false
